<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LidarrBin Condition="'$(LidarrBin)' == ''">$(MSBuildProjectDirectory)/../../.artifacts/lidarr</LidarrBin>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep plugin types in one assembly so Lidarr can reflect over them without loading a private DLL. -->
    <Compile Include="../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Reference Include="Lidarr.Core" HintPath="$(LidarrBin)/Lidarr.Core.dll" Private="false" />
    <Reference Include="Lidarr.Common" HintPath="$(LidarrBin)/Lidarr.Common.dll" Private="false" />
    <Reference Include="FluentValidation" HintPath="$(LidarrBin)/FluentValidation.dll" Private="false" />
    <Reference Include="NLog" HintPath="$(LidarrBin)/NLog.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLidarrReferences" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(LidarrBin)/Lidarr.Core.dll')">
    <Error Text="Extract the pinned Lidarr assemblies into .artifacts/lidarr before building." />
  </Target>
</Project>
